import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.model_selection import train_test_split

# ==========================================
# 1. 설정 및 CSV 데이터 로드
# ==========================================
CSV_FILENAME = "california_housing.csv"
FEATURES = [
    "MedInc",
    "HouseAge",
    "AveRooms",
    "Population",
    "AveOccup",
    "Latitude",
    "Longitude",
]
TARGET = "MedHouseVal"

N_ESTIMATORS = 100
RANDOM_STATE = 42
N_JOBS = -1

# 데이터 불러오기
df = pd.read_csv(CSV_FILENAME)

# 결측치 확인 및 제거 (필요시)
if df[FEATURES + [TARGET]].isnull().sum().sum() > 0:
  print("⚠️ 결측치가 존재하여 제거합니다.")
  df = df.dropna(subset=FEATURES + [TARGET])

X = df[FEATURES].values
y = df[TARGET].values

# ==========================================
# 2. 데이터셋 분할 (Train / Test Split)
# ==========================================
# 학습용(80%)과 테스트용(20%) 분리
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, random_state=RANDOM_STATE
)

# ==========================================
# 3. 랜덤 포레스트 모델 선언 및 학습
# ==========================================
print("\n=== 랜덤 포레스트 모델 학습 시작 ===")

# Keyword Arguments 형태로 명확히 전달
model = RandomForestRegressor(
    n_estimators=N_ESTIMATORS, random_state=RANDOM_STATE, n_jobs=N_JOBS
)
model.fit(X_train, y_train)

print("파이프라인 연동 및 학습 완료!")

# ==========================================
# 4. 전체 테스트 데이터셋 평가
# ==========================================
y_pred_test = model.predict(X_test)

rmse = np.sqrt(mean_squared_error(y_test, y_pred_test))
r2 = r2_score(y_test, y_pred_test)

print("\n=== 📈 전체 테스트 데이터셋 모델 성능 ===")
print(f"• RMSE (평균 제곱근 오차): {rmse:.4f}")
print(f"• R² Score (결정계수): {r2:.4f}")

# ==========================================
# 5. 테스트 데이터셋에서 무작위 추출 10개 샘플 평가
# ==========================================
# 모델이 학습 과정에서 한 번도 보지 못한 Test 데이터에서 무작위 추출
np.random.seed(RANDOM_STATE)  # 결과 재현성을 위한 시드 설정
random_indices = np.random.choice(len(X_test), size=10, replace=False)

sample_x = X_test[random_indices]
sample_y = y_test[random_indices]

# 추론 실행
sample_preds = model.predict(sample_x)

# 오차율 계산
abs_error = np.abs(sample_y - sample_preds)
error_rate_pct = (abs_error / np.maximum(sample_y, 1e-8)) * 100

# 결과 정리
result_df = pd.DataFrame({
    "Test Index": random_indices,
    "실제값 (Actual)": np.round(sample_y, 4),
    "예측값 (Pred)": np.round(sample_preds, 4),
    "절대 오차": np.round(abs_error, 4),
    "오차율 (%)": np.round(error_rate_pct, 2),
})

print("\n=== 📊 테스트 샘플 10개 예측 결과 비교 ===")
print(result_df.to_string(index=False))
